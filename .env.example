# Server-side only (spec 06 §2). Copy to .env.local for `npm run dev`; never prefix with VITE_.
AI_PHOTO_ENABLED=true
# Vision provider: gemini or anthropic (D34). Only the chosen provider's key is needed.
AI_PROVIDER=
# Use a paid (billing-enabled) Gemini key: on the free tier Google may use photos to improve its products.
GEMINI_API_KEY=
# Optional model override; defaults: gemini-3.8-flash / claude-haiku-5-5.
CHIP_VISION_MODEL=
RATE_LIMIT_PER_IP_PER_HOUR=10
DAILY_REQUEST_CAP=500
# Optional: the app's public origin (defaults to the request's own origin).
APP_ORIGIN=
